#--------------------------------------------------------------------
# API CLIENT (HUB) — REQUIRED
#--------------------------------------------------------------------
# Base URL to the hub API (ci4-api-starter). This admin talks to the hub for
# authentication, user management, files, and metrics.
#
# REQUIRED: Set this to your hub API URL
API_BASE_URL = http://localhost:8180

# Alternatively, use the dotted CI4 format:
# apiClient.baseUrl = http://localhost:8180
# apiClient.appName = 'CI4 Website Builder Admin'
# apiClient.apiPrefix = /api/v1
# apiClient.logRequests = false
#
# Optional: API App Key — raises rate limit from 60 req/min (IP-based) to 600 req/min (key-based).
# Create a key via POST /api/v1/api-keys (requires admin auth) or the admin panel at /admin/api-keys.
# Omit rather than set an invalid value — a wrong key returns 401 on every request.
# apiClient.appKey = apk_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

#--------------------------------------------------------------------
# DOMAIN API CLIENT (OPTIONAL — only if admin talks to a ci4-domain-starter)
#--------------------------------------------------------------------
# Configure these to wire a second backend in parallel to the hub. This is used
# when you have both a central hub (ci4-api-starter) and a separate domain app
# (ci4-domain-starter) that this admin manages.
#
# Modules scaffolded with `bash bin/make-module.sh ... --service=domain` will route
# their HTTP calls to this URL instead of the hub's apiClient.baseUrl.
#
# REQUIRED if domain-based modules are in use:
DOMAIN_API_BASE_URL = http://localhost:8190

# Alternatively, use the dotted CI4 format:
# domainApiClient.baseUrl = http://localhost:8190
# domainApiClient.apiPrefix = /api/v1
# domainApiClient.appName = Domain Client
# domainApiClient.logRequests = false

# Optional: API App Key for domain calls (same purpose as apiClient.appKey)
# domainApiClient.appKey = apk_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

#--------------------------------------------------------------------
# BFF API CLIENT (optional — only when a ci4-bff-starter is part of the stack)
#--------------------------------------------------------------------
# Leave bffApiClient.baseUrl empty (default) to disable BFF health monitoring.
# Set it to show a BFF health card on the admin dashboard.
#
# bffApiClient.baseUrl = 'http://localhost:8088'
# bffApiClient.apiPrefix = '/api/v1'
# bffApiClient.appName = 'BFF Gateway'
# bffApiClient.logRequests = false

# Maximum file upload size in bytes (applies to frontend validation + server rules)
# FILE_MAX_SIZE = 10485760
